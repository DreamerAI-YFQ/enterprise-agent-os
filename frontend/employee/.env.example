# Build-time backend URL for Tauri desktop distribution.
# When set, the desktop app will use this URL by default instead of
# requiring users to configure it in Settings.
#
# Example for an enterprise deployment:
# VITE_API_BASE_URL=http://192.168.1.100:8000/api
#
# Leave unset to let users configure via Settings → 后端连接.
VITE_API_BASE_URL=
