# Example Secret — copy to secret.yaml and fill real values.
# Real secret.yaml MUST NOT be committed to git.
#
#   cp deploy/k8s/secret.yaml.example deploy/k8s/secret.yaml
#   edit values, then: kubectl apply -f deploy/k8s/secret.yaml
#
# Values below are base64-encoded placeholders. Generate your own with:
#   echo -n 'your-value' | base64
apiVersion: v1
kind: Secret
metadata:
  name: eaos-secret
  namespace: eaos
type: Opaque
data:
  # JWT signing key (required). echo -n 'change-me' | base64
  EAOS_SECRET_KEY: Y2hhbmdlLW1lLWluLXByb2R1Y3Rpb24=
  # OpenAI API key. echo -n 'sk-...' | base64
  EAOS_LLM__OPENAI_API_KEY: c2stY2hhbmdlLW1l
  # Anthropic API key (optional). echo -n 'sk-ant-...' | base64
  EAOS_LLM__ANTHROPIC_API_KEY: c2stYW50LWNoYW5nZS1tZQ==
