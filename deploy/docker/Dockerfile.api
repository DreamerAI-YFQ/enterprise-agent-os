FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

# Install system deps: xmlsec1 for SAML SP (python3-saml), libxml2 for lxml.
RUN apt-get update && apt-get install -y --no-install-recommends \
    xmlsec1 libxml2 libxmlsec1 libxmlsec1-openssl && \
    rm -rf /var/lib/apt/lists/*

# Install uv (single static binary, no Python needed).
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Copy workspace manifests first for better layer caching.
COPY pyproject.toml uv.lock ./
COPY packages/ ./packages/
COPY apps/ ./apps/
COPY alembic.ini ./

# Install all workspace packages (no dev deps for slimmer image).
RUN uv sync --all-packages --no-dev

EXPOSE 8000

HEALTHCHECK --interval=15s --timeout=5s --retries=5 \
    CMD /app/.venv/bin/python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health')" || exit 1

CMD ["/app/.venv/bin/uvicorn", "eaos_api.main:app", "--host", "0.0.0.0", "--port", "8000"]
