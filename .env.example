# EAOS — Development environment configuration
# Copy this file to .env and fill in real values.
# .env is gitignored; never commit secrets.

# ----- Database (PostgreSQL + pgvector) -----
# Uses asyncpg driver at runtime. alembic env.py converts to psycopg for sync migrations.
EAOS_DB__URL=postgresql+asyncpg://eaos:eaos@localhost:5432/eaos

# ----- Redis -----
EAOS_REDIS__URL=redis://localhost:6379/0

# ----- LLM providers -----
# Supports OpenAI, Anthropic, GLM, or any OpenAI-compatible provider (DashScope, etc.)
# For DashScope (阿里云百炼): set OPENAI_BASE_URL to https://dashscope.aliyuncs.com/compatible-mode/v1
EAOS_LLM__OPENAI_API_KEY=
EAOS_LLM__OPENAI_BASE_URL=
EAOS_LLM__ANTHROPIC_API_KEY=
EAOS_LLM__GLM_API_KEY=
# Default model used by LLMRouterImpl when no hint/routing applies
EAOS_LLM__DEFAULT_MODEL=gpt-4o-mini
# Vision model override (e.g. qwen3-omni-flash for DashScope)
EAOS_LLM__VISION_MODEL=

# ----- Embedding (OpenAI-compatible; works with OpenAI/Zhipu/DashScope/local) -----
# Leave EAOS_EMBEDDING__API_KEY blank to skip embeddings in dev.
# For DashScope: BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1, MODEL=text-embedding-v3
EAOS_EMBEDDING__API_KEY=
EAOS_EMBEDDING__BASE_URL=
EAOS_EMBEDDING__MODEL=text-embedding-3-small
EAOS_EMBEDDING__DIMENSIONS=1024

# ----- OpenTelemetry -----
# Set to http://localhost:4318 (OTLP HTTP) to export to local collector.
# Leave blank for no-op (dev convenience).
EAOS_OTEL__ENDPOINT=
EAOS_OTEL__SERVICE_NAME=eaos-api

# ----- Slack (optional) -----
EAOS_SLACK__BOT_TOKEN=
EAOS_SLACK__SIGNING_SECRET=

# ----- DingTalk (optional) -----
EAOS_DINGTALK__APP_KEY=
EAOS_DINGTALK__APP_SECRET=
EAOS_DINGTALK__ROBOT_CODE=

# ----- App -----
EAOS_APP__SECRET_KEY=dev-secret-change-in-prod
EAOS_APP__DEBUG=true
EAOS_APP__ENVIRONMENT=local

# ----- Evolution artifacts -----
# Local directory for DPO-trained model artifacts (Phase 5 trainer output).
# Phase 6 T13 may swap this for S3/OSS object storage.
EAOS_APP__MODEL_ARTIFACT_DIR=/tmp/eaos/models
